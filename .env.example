PORT=3000
AUTH_SECRET=replace-with-a-long-random-secret
SESSION_TTL_HOURS=168
GUEST_TTL_DAYS=365
USER_HISTORY_LIMIT=50
NODE_ENV=development
DEFAULT_ADMIN_EMAIL=admin@clipflow.local
DEFAULT_ADMIN_PASSWORD=Admin@123456
DEFAULT_ADMIN_NAME=管理员

# Commercial MVP switches.
COMMERCIAL_MODE=true
PAYMENT_PROVIDER=manual
PAYMENT_RECEIVER_NAME=ClipFlow
PAYMENT_WECHAT_QR_URL=/assets/payments/wechat-qr.jpg
PAYMENT_ALIPAY_QR_URL=/assets/payments/alipay-qr.jpg
STORAGE_PROVIDER=local
QUEUE_PROVIDER=in-process
DATABASE_URL=
REDIS_URL=
# Public website origin for SEO files (robots/sitemap), e.g. https://www.yourdomain.com
PUBLIC_SITE_URL=http://localhost:3000

# Production storage placeholders. Use one provider in production:
# Cloudflare R2 / AWS S3 / 阿里云 OSS / 腾讯云 COS.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Payment placeholders. For manual QR + auto-upgrade, configure
# PAYMENT_WEBHOOK_SECRET and set your payment platform notify URL to:
# https://your-domain/api/payments/webhook?token=PAYMENT_WEBHOOK_SECRET
PAYMENT_WEBHOOK_SECRET=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Douyin parsing providers are tried in order. Free providers may be unstable;
# token providers are skipped automatically when their key is empty.
DOUYIN_PROVIDERS=tikhub,xinyew,mxin,jxcxin,devtool,makuo,mujie

# Optional paid/provider keys.
TIKHUB_BASE_URL=https://api.tikhub.io
TIKHUB_API_KEY=
MAKUO_TOKEN=
MUJIE_KEY=

# Keep this false to reject TikHub's known watermarked download_addr fallback.
ALLOW_WATERMARK_FALLBACK=false

# Generate a local high-quality MP4 with FFmpeg for the primary video download.
# Set AUTO_MEDIA_PROCESSING=false in production when you want parsing results to
# return quickly and skip server-side MP3/transcription generation.
AUTO_MEDIA_PROCESSING=true
LOG_PROVIDER_TIMINGS=true
ENABLE_VIDEO_OPTIMIZE=true
VIDEO_OPTIMIZE_CRF=18
VIDEO_OPTIMIZE_PRESET=medium

# Optional transcription provider. Leave empty to disable transcription while
# keeping video, cover, BGM, MP3 and ZIP downloads working.
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_LANGUAGE=zh
TRANSCRIPTION_MAX_MB=25

# Optional AI rewrite provider. OpenAI-compatible chat completions endpoint.
# If REWRITE_API_KEY is empty, the server reuses TRANSCRIPTION_API_KEY when present.
REWRITE_API_KEY=
REWRITE_BASE_URL=https://api.siliconflow.cn/v1/chat/completions
REWRITE_MODEL=Qwen/Qwen2.5-7B-Instruct
REWRITE_TEMPERATURE=0.75
REWRITE_MAX_TOKENS=500

# Runtime limits.
MAX_LINKS_PER_JOB=5
MAX_DOWNLOAD_MB=200
JOB_TTL_MINUTES=120

# Parse performance tuning.
PROVIDER_REQUEST_TIMEOUT_MS=9000
REDIRECT_TIMEOUT_MS=4500
REDIRECT_FAST_BUDGET_MS=1200
REDIRECT_MAX_HOPS=3
MAX_CANDIDATE_URLS=2
PARSE_PROVIDER_CONCURRENCY=4
PARSE_CACHE_TTL_MINUTES=30
